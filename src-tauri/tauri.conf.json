{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cognuum",
  "version": "0.2.0",
  "identifier": "com.cognuum.desktop",
  "build": {
    "frontendDist": "../fallback"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "desktop-workspace",
          "local": false,
          "windows": [
            "main",
            "workspace-*"
          ],
          "platforms": [
            "macOS",
            "windows"
          ],
          "remote": {
            "urls": [
              "https://access.cognuum.com/*"
            ]
          },
          "permissions": [
            "allow-desktop-auth-read",
            "allow-desktop-auth-write",
            "allow-desktop-auth-lock",
            "allow-desktop-auth-unlock",
            "allow-desktop-workspace-ready",
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ],
      "csp": "default-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; connect-src 'none'; script-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Finance",
    "shortDescription": "Your private intelligence system",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "desktop": {
      "origin": "https://access.cognuum.com",
      "channel": "production",
      "scheme": "cognuum"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "cognuum"
        ]
      }
    }
  }
}
