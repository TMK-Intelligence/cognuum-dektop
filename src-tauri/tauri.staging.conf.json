{
  "productName": "Cognuum Staging",
  "identifier": "com.cognuum.desktop.staging",
  "plugins": {
    "desktop": {
      "origin": "https://staging-access.cognuum.com",
      "channel": "staging",
      "scheme": "cognuum-staging"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "cognuum-staging"
        ]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "desktop-workspace",
          "local": false,
          "windows": [
            "main",
            "workspace-*"
          ],
          "platforms": [
            "macOS",
            "windows"
          ],
          "remote": {
            "urls": [
              "https://staging-access.cognuum.com/*"
            ]
          },
          "permissions": [
            "allow-desktop-auth-read",
            "allow-desktop-auth-write",
            "allow-desktop-auth-lock",
            "allow-desktop-auth-unlock",
            "allow-desktop-workspace-ready",
            "allow-desktop-save-pdf",
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  }
}
